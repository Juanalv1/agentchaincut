{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentchaincut.dev/contracts/trace.schema.json",
  "title": "Trace session",
  "description": "One line of traces.jsonl: one agent session with its trusted context and ordered tool calls. Provenance strings: 'system' (fetched from the backend, trusted), 'user', 'llm', 'constant', 'context:<ctx.path>', 'tool_output:<server.tool>#<seq>'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "task_id", "label", "context", "context_provenance", "calls"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "label": {"enum": ["legit", "abuse"]},
    "attack": {
      "type": "string",
      "description": "Optional abuse family for abuse sessions, e.g. foreign_recipient, foreign_object_id, cross_ticket, injected_context."
    },
    "context": {
      "type": "object",
      "description": "Flat map of dotted context paths to values.",
      "propertyNames": {"$ref": "#/$defs/ctxPath"},
      "additionalProperties": {"$ref": "#/$defs/ctxValue"}
    },
    "context_provenance": {
      "type": "object",
      "description": "Provenance per context path; only 'system' fields may back an accepted invariant.",
      "propertyNames": {"$ref": "#/$defs/ctxPath"},
      "additionalProperties": {"$ref": "#/$defs/provenance"}
    },
    "calls": {
      "type": "array",
      "items": {"$ref": "#/$defs/call"}
    }
  },
  "$defs": {
    "ctxPath": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$"},
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "ctxValue": {
      "anyOf": [
        {"$ref": "#/$defs/scalar"},
        {"type": "array", "items": {"$ref": "#/$defs/scalar"}}
      ]
    },
    "provenance": {
      "type": "string",
      "pattern": "^(system|user|llm|constant|context:[a-z_][a-z0-9_.]*|tool_output:[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*#[0-9]+)$"
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "tool", "args", "arg_provenance"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
        "args": {"type": "object"},
        "arg_provenance": {
          "type": "object",
          "description": "Provenance per argument name.",
          "additionalProperties": {"$ref": "#/$defs/provenance"}
        },
        "result": {"description": "Optional tool output (any JSON)."}
      }
    }
  }
}
